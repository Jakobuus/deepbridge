{
  "value_nodes": [
    {
      "id": "value:hopo-f-decorp",
      "kind": "feature",
      "text": "3,4,3-LI(1,2-HOPO): an orally active actinide decorporation agent (plutonium, uranium, americium, neptunium), preclinical, well tolerated in rats at high oral doses",
      "source": "paper",
      "evidence_ids": [
        "evidence:value-map:hopo-dtpa",
        "evidence:value-map:hopo-oral"
      ]
    },
    {
      "id": "value:hopo-f-affinity",
      "kind": "feature",
      "text": "High affinity for hard metal ions (lanthanides, actinides, and the toxic heavy metals Pb and Cd) from one octadentate hydroxypyridonate ligand",
      "source": "paper",
      "evidence_ids": [
        "evidence:value-map:hopo-unrivaled",
        "evidence:value-map:hopo-ln",
        "evidence:value-map:hopo-pb"
      ]
    },
    {
      "id": "value:hopo-f-zr",
      "kind": "feature",
      "text": "89Zr PET chelation: Zr-HOPO complex matched or surpassed the stability of the current DFO chelator and cleared rapidly in healthy mice",
      "source": "paper",
      "evidence_ids": [
        "evidence:value-map:hopo-zr",
        "evidence:value-map:hopo-zrclear"
      ]
    },
    {
      "id": "value:hopo-f-gd",
      "kind": "feature",
      "text": "Gadolinium removal: more effective than DTPA at chelating and removing gadolinium from the body in a preclinical study",
      "source": "paper",
      "evidence_ids": [
        "evidence:value-map:hopo-gd"
      ]
    },
    {
      "id": "value:hopo-b-dtpa",
      "kind": "benefit",
      "text": "Could remove internalized plutonium and uranium more effectively than the approved agent DTPA, as an oral drug",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-dtpa",
        "evidence:value-map:hopo-oral"
      ]
    },
    {
      "id": "value:hopo-b-pet",
      "kind": "benefit",
      "text": "Could give a safer PET tracer with reduced background radiation dose by stopping 89Zr release",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-safer",
        "evidence:value-map:hopo-zr"
      ]
    },
    {
      "id": "value:hopo-b-gd",
      "kind": "benefit",
      "text": "Could mitigate gadolinium retention in patients who need contrast-enhanced MRI",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-mitigate",
        "evidence:value-map:hopo-gd"
      ]
    },
    {
      "id": "value:hopo-v-prep",
      "kind": "value",
      "text": "Radiological-emergency planners and defense stockpiles could gain an oral decorporation option beyond DTPA",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-dtpa",
        "evidence:value-map:hopo-bomb",
        "evidence:value-map:hopo-oral"
      ]
    },
    {
      "id": "value:hopo-v-pet",
      "kind": "value",
      "text": "Radiopharmaceutical and PET-imaging developers could swap DFO for a more stable 89Zr chelator",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-safer",
        "evidence:value-map:hopo-zr"
      ]
    },
    {
      "id": "value:hopo-v-gd",
      "kind": "value",
      "text": "MRI contrast-agent makers and clinicians could offer a post-hoc remedy for gadolinium deposition",
      "source": "inferred",
      "evidence_ids": [
        "evidence:value-map:hopo-mitigate",
        "evidence:value-map:hopo-gd"
      ]
    },
    {
      "id": "value:hopo-p-limited",
